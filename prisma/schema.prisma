generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RepairJobStatus {
  InProgress           @map("In Progress")
  AwaitingDiagnosis    @map("Awaiting Diagnosis")
  AwaitingParts        @map("Awaiting Parts")
  AwaitingApproval     @map("Awaiting Approval")
  ReadyForCollection   @map("Ready for Collection")
  Overdue              @map("Overdue")

  @@map("repair_job_status")
}

enum AppointmentStatus {
  Confirmed @map("Confirmed")
  DropOff   @map("Drop-off")
  Collection @map("Collection")

  @@map("appointment_status")
}

model Customer {
  id           BigInt   @id
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  email        String   @db.VarChar(255)
  phone        String?  @db.VarChar(30)
  company      String?  @db.VarChar(255)
  addressLine1 String?  @map("address_line1") @db.VarChar(255)
  addressLine2 String?  @map("address_line2") @db.VarChar(255)
  city         String?  @db.VarChar(100)
  county       String?  @db.VarChar(100)
  postcode     String?  @db.VarChar(20)
  country      String?  @default("United Kingdom") @db.VarChar(100)
  notes        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  repairJobs   RepairJob[]
  appointments Appointment[]

  @@map("customers")
}

model Technician {
  id           BigInt       @id @default(autoincrement())
  firstName    String       @map("first_name") @db.VarChar(100)
  lastName     String       @map("last_name") @db.VarChar(100)
  isActive     Boolean      @default(true) @map("is_active")
  repairJobs   RepairJob[]
  appointments Appointment[]
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([lastName, firstName])
  @@map("technicians")
}

model RepairJob {
  id           BigInt          @id @default(autoincrement())
  reference    String          @unique @db.VarChar(30)
  customerId   BigInt          @map("customer_id")
  equipment    String          @db.VarChar(255)
  issue        String
  status       RepairJobStatus @default(AwaitingDiagnosis)
  technicianId BigInt?         @map("technician_id")
  dateReceived DateTime        @map("date_received") @db.Date
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  technician   Technician?     @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([customerId, dateReceived])
  @@index([technicianId, status])
  @@index([status, dateReceived])
  @@map("repair_jobs")
}

model Appointment {
  id           BigInt            @id @default(autoincrement())
  customerId   BigInt            @map("customer_id")
  technicianId BigInt?           @map("technician_id")
  scheduledAt  DateTime          @map("scheduled_at") @db.Timestamptz(6)
  repairType   String            @map("repair_type") @db.VarChar(255)
  status       AppointmentStatus
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  technician   Technician?       @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([scheduledAt])
  @@index([customerId, scheduledAt])
  @@map("appointments")
}