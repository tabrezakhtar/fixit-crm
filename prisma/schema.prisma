generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RepairJobStatus {
  InProgress           @map("In Progress")
  AwaitingDiagnosis    @map("Awaiting Diagnosis")
  AwaitingParts        @map("Awaiting Parts")
  AwaitingApproval     @map("Awaiting Approval")
  ReadyForCollection   @map("Ready for Collection")
  Overdue              @map("Overdue")

  @@map("repair_job_status")
}

enum AppointmentStatus {
  Confirmed @map("Confirmed")
  DropOff   @map("Drop-off")
  Collection @map("Collection")

  @@map("appointment_status")
}

enum QuoteStatus {
  Draft    @map("Draft")
  Sent     @map("Sent")
  Accepted @map("Accepted")
  Declined @map("Declined")
  Expired  @map("Expired")

  @@map("quote_status")
}

enum InvoiceStatus {
  Draft           @map("Draft")
  Sent            @map("Sent")
  PartiallyPaid   @map("Partially paid")
  Paid            @map("Paid")
  Overdue         @map("Overdue")
  Void            @map("Void")

  @@map("invoice_status")
}

enum PaymentMethod {
  Cash          @map("Cash")
  Card          @map("Card")
  BankTransfer  @map("Bank transfer")
  Other         @map("Other")

  @@map("payment_method")
}

model Customer {
  id           BigInt   @id
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  email        String   @db.VarChar(255)
  phone        String?  @db.VarChar(30)
  company      String?  @db.VarChar(255)
  addressLine1 String?  @map("address_line1") @db.VarChar(255)
  addressLine2 String?  @map("address_line2") @db.VarChar(255)
  city         String?  @db.VarChar(100)
  county       String?  @db.VarChar(100)
  postcode     String?  @db.VarChar(20)
  country      String?  @default("United Kingdom") @db.VarChar(100)
  notes        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  repairJobs   RepairJob[]
  appointments Appointment[]
  quotes       Quote[]
  invoices     Invoice[]

  @@map("customers")
}

model Technician {
  id           BigInt       @id @default(autoincrement())
  firstName    String       @map("first_name") @db.VarChar(100)
  lastName     String       @map("last_name") @db.VarChar(100)
  isActive     Boolean      @default(true) @map("is_active")
  repairJobs   RepairJob[]
  appointments Appointment[]
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([lastName, firstName])
  @@map("technicians")
}

model RepairJob {
  id           BigInt          @id @default(autoincrement())
  reference    String          @unique @db.VarChar(30)
  customerId   BigInt          @map("customer_id")
  equipment    String          @db.VarChar(255)
  issue        String
  status       RepairJobStatus @default(AwaitingDiagnosis)
  technicianId BigInt?         @map("technician_id")
  dateReceived DateTime        @map("date_received") @db.Date
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  technician   Technician?     @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  quotes       Quote[]
  invoices     Invoice[]

  @@index([customerId, dateReceived])
  @@index([technicianId, status])
  @@index([status, dateReceived])
  @@map("repair_jobs")
}

model Quote {
  id           BigInt      @id @default(autoincrement())
  reference    String      @unique @db.VarChar(30)
  customerId   BigInt      @map("customer_id")
  repairJobId  BigInt?     @map("repair_job_id")
  status       QuoteStatus @default(Draft)
  issuedAt     DateTime    @map("issued_at") @db.Date
  validUntil   DateTime    @map("valid_until") @db.Date
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  repairJob    RepairJob?  @relation(fields: [repairJobId], references: [id], onDelete: SetNull)
  items        QuoteItem[]
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([customerId, issuedAt])
  @@index([repairJobId])
  @@index([status, validUntil])
  @@map("quotes")
}

model QuoteItem {
  id             BigInt @id @default(autoincrement())
  quoteId        BigInt @map("quote_id")
  description    String @db.VarChar(255)
  quantity       Int
  unitPricePence Int    @map("unit_price_pence")
  quote          Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

model Invoice {
  id          BigInt        @id @default(autoincrement())
  reference   String        @unique @db.VarChar(30)
  customerId  BigInt        @map("customer_id")
  repairJobId BigInt?       @map("repair_job_id")
  status      InvoiceStatus @default(Draft)
  issuedAt    DateTime      @map("issued_at") @db.Date
  dueAt       DateTime      @map("due_at") @db.Date
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  repairJob   RepairJob?    @relation(fields: [repairJobId], references: [id], onDelete: SetNull)
  items       InvoiceItem[]
  payments    Payment[]
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([customerId, issuedAt])
  @@index([repairJobId])
  @@index([status, dueAt])
  @@map("invoices")
}

model InvoiceItem {
  id             BigInt  @id @default(autoincrement())
  invoiceId      BigInt  @map("invoice_id")
  description    String  @db.VarChar(255)
  quantity       Int
  unitPricePence Int     @map("unit_price_pence")
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id            BigInt        @id @default(autoincrement())
  invoiceId     BigInt        @map("invoice_id")
  amountPence   Int           @map("amount_pence")
  method        PaymentMethod
  reference     String?       @db.VarChar(100)
  paidAt        DateTime      @map("paid_at") @db.Date
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([invoiceId, paidAt])
  @@map("payments")
}

model InventoryItem {
  id              BigInt   @id @default(autoincrement())
  sku             String   @unique @db.VarChar(40)
  name            String   @db.VarChar(255)
  category        String   @db.VarChar(100)
  supplier        String   @db.VarChar(255)
  quantityOnHand  Int      @map("quantity_on_hand")
  reorderLevel    Int      @map("reorder_level")
  unitCostPence   Int      @map("unit_cost_pence")
  location        String?  @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([category, name])
  @@index([quantityOnHand, reorderLevel])
  @@map("inventory_items")
}

model Appointment {
  id           BigInt            @id @default(autoincrement())
  customerId   BigInt            @map("customer_id")
  technicianId BigInt?           @map("technician_id")
  scheduledAt  DateTime          @map("scheduled_at") @db.Timestamptz(6)
  repairType   String            @map("repair_type") @db.VarChar(255)
  status       AppointmentStatus
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  technician   Technician?       @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([scheduledAt])
  @@index([customerId, scheduledAt])
  @@map("appointments")
}